<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 500 500" width="100%" height="100%">
  <defs>
    <!-- Gradients -->
    <linearGradient id="goldGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#fef08a" />
      <stop offset="50%" stop-color="#eab308" />
      <stop offset="100%" stop-color="#a16207" />
    </linearGradient>
    <linearGradient id="redRibbonGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#ef4444" />
      <stop offset="50%" stop-color="#dc2626" />
      <stop offset="100%" stop-color="#991b1b" />
    </linearGradient>
    <linearGradient id="greenLeaf" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#22c55e" />
      <stop offset="100%" stop-color="#15803d" />
    </linearGradient>
    <!-- Text Paths -->
    <path id="curveTop" d="M 50 200 A 200 200 0 0 1 450 200" fill="none" />
    <path id="curveSub" d="M 90 200 A 160 160 0 0 1 410 200" fill="none" />
    <path id="curveRibbon" d="M 120 448 Q 250 478 380 448" fill="none" />
  </defs>

  <!-- Background clean circle (optional subtle) -->
  <circle cx="250" cy="250" r="240" fill="#ffffff" />

  <!-- Arched Title: RAID ACTION WING -->
  <text font-family="'Space Grotesk', 'Impact', sans-serif" font-weight="900" font-size="34" fill="#1e40af" letter-spacing="3">
    <textPath href="#curveTop" startOffset="50%" text-anchor="middle">
      RAID ACTION WING
    </textPath>
  </text>

  <!-- Arched Hindi: छापा कार्यवाही विभाग -->
  <text font-family="'Poppins', 'Noto Sans Devanagari', sans-serif" font-weight="800" font-size="28" fill="#dc2626" letter-spacing="1">
    <textPath href="#curveSub" startOffset="50%" text-anchor="middle">
      छापा कार्यवाही विभाग
    </textPath>
  </text>

  <!-- Golden Wheat Ears (Top Left & Top Right) -->
  <g id="wheatLeft" transform="translate(110, 160) rotate(-25)">
    <ellipse cx="0" cy="0" rx="14" ry="24" fill="url(#goldGrad)" />
    <ellipse cx="-10" cy="-20" rx="10" ry="18" fill="url(#goldGrad)" />
    <ellipse cx="10" cy="-20" rx="10" ry="18" fill="url(#goldGrad)" />
    <ellipse cx="-8" cy="-42" rx="8" ry="16" fill="url(#goldGrad)" />
    <ellipse cx="8" cy="-42" rx="8" ry="16" fill="url(#goldGrad)" />
    <path d="M 0 25 L 0 -55" stroke="#ca8a04" stroke-width="3" />
  </g>

  <g id="wheatRight" transform="translate(390, 160) scale(-1, 1) rotate(-25)">
    <ellipse cx="0" cy="0" rx="14" ry="24" fill="url(#goldGrad)" />
    <ellipse cx="-10" cy="-20" rx="10" ry="18" fill="url(#goldGrad)" />
    <ellipse cx="10" cy="-20" rx="10" ry="18" fill="url(#goldGrad)" />
    <ellipse cx="-8" cy="-42" rx="8" ry="16" fill="url(#goldGrad)" />
    <ellipse cx="8" cy="-42" rx="8" ry="16" fill="url(#goldGrad)" />
    <path d="M 0 25 L 0 -55" stroke="#ca8a04" stroke-width="3" />
  </g>

  <!-- Ashoka Emblem Center (Stylized Triple Lion Capital) -->
  <g transform="translate(250, 205)" id="lionCapital">
    <!-- Center Lion -->
    <path d="M -22 -65 C -25 -80, 25 -80, 22 -65 C 32 -55, 30 -35, 20 -25 C 24 -10, 15 15, 0 20 C -15 15, -24 -10, -20 -25 C -30 -35, -32 -55, -22 -65 Z" fill="#1e3a8a" />
    <path d="M -15 -60 C -15 -72, 15 -72, 15 -60 C 22 -52, 20 -38, 12 -30 C 14 -15, 8 8, 0 12 C -8 8, -14 -15, -12 -30 C -20 -38, -22 -52, -15 -60 Z" fill="#ffffff" />
    <!-- Facial details -->
    <circle cx="-6" cy="-48" r="2.5" fill="#1e3a8a" />
    <circle cx="6" cy="-48" r="2.5" fill="#1e3a8a" />
    <polygon points="0,-42 -4,-36 4,-36" fill="#1e3a8a" />
    <path d="M -7 -32 Q 0 -28 7 -32" stroke="#1e3a8a" stroke-width="2" fill="none" />
    <path d="M 0 -28 L 0 -18" stroke="#1e3a8a" stroke-width="2" />
    <path d="M -12 -22 Q -4 -16 -12 -8 M 12 -22 Q 4 -16 12 -8" stroke="#1e3a8a" stroke-width="1.8" fill="none" />
    
    <!-- Left Lion (Profile) -->
    <path d="M -22 -55 C -38 -68, -55 -60, -58 -45 C -62 -30, -52 -18, -42 -12 C -45 2, -35 15, -20 18 C -22 5, -22 -20, -22 -55 Z" fill="#1e3a8a" />
    <circle cx="-45" cy="-40" r="2.5" fill="#ffffff" />
    <path d="M -50 -32 Q -44 -28 -38 -34" stroke="#ffffff" stroke-width="1.8" fill="none" />

    <!-- Right Lion (Profile) -->
    <path d="M 22 -55 C 38 -68, 55 -60, 58 -45 C 62 -30, 52 -18, 42 -12 C 45 2, 35 15, 20 18 C 22 5, 22 -20, 22 -55 Z" fill="#1e3a8a" />
    <circle cx="45" cy="-40" r="2.5" fill="#ffffff" />
    <path d="M 50 -32 Q 44 -28 38 -34" stroke="#ffffff" stroke-width="1.8" fill="none" />

    <!-- Base Abacus -->
    <rect x="-42" y="20" width="84" height="12" rx="3" fill="#1e3a8a" />
    <circle cx="0" cy="26" r="4.5" fill="#ffffff" stroke="#1e3a8a" stroke-width="1.5" />
    <line x1="-32" y1="26" x2="-14" y2="26" stroke="#ffffff" stroke-width="2" stroke-linecap="round" />
    <line x1="14" y1="26" x2="32" y2="26" stroke="#ffffff" stroke-width="2" stroke-linecap="round" />
  </g>

  <!-- Laurel Wreath Curving (Leaves along sides) -->
  <g id="wreathGroup">
    <!-- Left Branch -->
    <g transform="translate(100, 270)">
      <path d="M 20 120 C -20 60, -30 -40, 2 -90" stroke="#15803d" stroke-width="4" fill="none" />
      <!-- Left Leaves -->
      <path d="M 0 -80 C -15 -85, -20 -70, -5 -65 C -20 -60, -25 -45, -5 -40 C -25 -35, -30 -15, -8 -10 C -28 -5, -32 15, -10 20 C -25 25, -28 45, -8 50 C -20 58, -20 78, 2 82 C -10 90, -10 105, 12 110" fill="url(#greenLeaf)" stroke="#166534" stroke-width="1.5" />
      <path d="M 5 -70 C 15 -75, 20 -60, 5 -55 C 20 -50, 25 -35, 5 -30 C 25 -25, 30 -5, 8 0 C 28 5, 32 25, 10 30 C 25 35, 28 55, 8 60 C 20 68, 20 88, -2 92" fill="url(#greenLeaf)" stroke="#166534" stroke-width="1.5" />
    </g>
    <!-- Right Branch -->
    <g transform="translate(400, 270) scale(-1, 1)">
      <path d="M 20 120 C -20 60, -30 -40, 2 -90" stroke="#15803d" stroke-width="4" fill="none" />
      <!-- Right Leaves -->
      <path d="M 0 -80 C -15 -85, -20 -70, -5 -65 C -20 -60, -25 -45, -5 -40 C -25 -35, -30 -15, -8 -10 C -28 -5, -32 15, -10 20 C -25 25, -28 45, -8 50 C -20 58, -20 78, 2 82 C -10 90, -10 105, 12 110" fill="url(#greenLeaf)" stroke="#166534" stroke-width="1.5" />
      <path d="M 5 -70 C 15 -75, 20 -60, 5 -55 C 20 -50, 25 -35, 5 -30 C 25 -25, 30 -5, 8 0 C 28 5, 32 25, 10 30 C 25 35, 28 55, 8 60 C 20 68, 20 88, -2 92" fill="url(#greenLeaf)" stroke="#166534" stroke-width="1.5" />
    </g>
  </g>

  <!-- Central Bold RAW & INDIA -->
  <text x="250" y="325" font-family="'Times New Roman', serif" font-weight="bold" font-size="52" fill="#1e3a8a" text-anchor="middle" letter-spacing="10">
    RAW
  </text>
  <text x="250" y="358" font-family="'Inter', sans-serif" font-weight="900" font-size="20" fill="#1e3a8a" text-anchor="middle" letter-spacing="8">
    INDIA
  </text>

  <!-- Red Decorative Ceremonial Ribbon Banner at Base -->
  <g id="ceremonialRibbon">
    <!-- Ribbon Shadow/Folds -->
    <path d="M 100 455 L 75 425 L 125 425 L 120 455 Z" fill="#7f1d1d" />
    <path d="M 400 455 L 425 425 L 375 425 L 380 455 Z" fill="#7f1d1d" />
    <polygon points="75,425 50,445 75,465 110,455" fill="#b91c1c" stroke="#ca8a04" stroke-width="1.5" />
    <polygon points="425,425 450,445 425,465 390,455" fill="#b91c1c" stroke="#ca8a04" stroke-width="1.5" />

    <!-- Main Front Ribbon Curve -->
    <path d="M 100 440 Q 250 480 400 440 L 405 470 Q 250 510 95 470 Z" fill="url(#redRibbonGrad)" stroke="#facc15" stroke-width="3" />
    <path d="M 102 444 Q 250 484 398 444" stroke="#fef08a" stroke-width="1" fill="none" opacity="0.8" />
    <path d="M 98 466 Q 250 506 402 466" stroke="#fef08a" stroke-width="1" fill="none" opacity="0.8" />

    <!-- Satyameva Jayate (सत्यमेव जयते) in White -->
    <text font-family="'Poppins', 'Noto Sans Devanagari', sans-serif" font-weight="700" font-size="25" fill="#ffffff" text-anchor="middle">
      <textPath href="#curveRibbon" startOffset="50%" text-anchor="middle">
        सत्यमेव जयते
      </textPath>
    </text>
  </g>
</svg>
