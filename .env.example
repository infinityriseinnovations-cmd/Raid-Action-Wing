# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SMTP Email & OTP Verification Configuration
SMTP_HOST="mail.raidactionwing.in"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="info@raidactionwing.in"
SMTP_PASS="YOUR_SMTP_PASSWORD"
SMTP_FROM='"Raid Action Wing Foundation" <info@raidactionwing.in>'

# MySQL Database Configuration (cPanel phpMyAdmin)
DB_HOST="127.0.0.1"
DB_PORT="3306"
DB_USER="cpanel_db_user"
DB_PASSWORD="cpanel_db_password"
DB_NAME="cpanel_db_name"

# Client-Side API Endpoint (Optional if serving from same origin)
# VITE_API_URL="https://api.yourdomain.com"

